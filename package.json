{
  "name": "ragevfx",
  "version": "3.11.0",
  "description": "The industry-leading Node-based Visual Effects program rivaling Nuke, Houdini, Cinema 4D, Blender, Maya, and Fusion with advanced compositing, procedural generation, MoGraph cloner tools, Blender-style geometry nodes, physics particles, Maya-style ocean simulation, Fusion dual viewers, VFX asset database, motion graphics, 2D-to-3D stereoscopic conversion, depth map generation, Smart Vector motion-aware painting, OpenVDB import/export, procedural VDB nodes (clouds, smoke, fire, water, snow), Blender integration addon, VEX-style wrangles, comprehensive blood splatter effects, professional muzzle flash simulation, realistic dust particles, and professional pipeline tools",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "build:clean": "npm run clean && npm run build",
    "clean": "rimraf dist dist-web",
    "start": "node server.js",
    "start:electron": "npm run build && electron .",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"examples/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "build:web": "vite build",
    "dev:web": "vite",
    "preview:web": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --win --mac --linux",
    "prepare": "npm run build"
  },
  "keywords": [
    "vfx",
    "visual-effects",
    "compositing",
    "node-based",
    "rendering",
    "3d",
    "gpu-accelerated"
  ],
  "author": "RageVFX Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "gl-matrix": "^3.4.4",
    "three": "^0.182.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.4",
    "@types/three": "^0.182.0",
    "autoprefixer": "^10.4.20",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "globals": "^16.2.0",
    "jest": "^30.2.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "build": {
    "appId": "com.ragevfx.app",
    "productName": "RageVFX",
    "copyright": "Copyright © 2024 RageVFX Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "RageVFX Team"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RageVFX",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "RageVFX-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Graphics"
    },
    "dmg": {
      "title": "RageVFX ${version}",
      "icon": "build/icon.icns"
    }
  }
}
