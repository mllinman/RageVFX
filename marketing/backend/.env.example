# Stripe API Keys
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Stripe Webhook Secret (for production webhook verification)
# Get this from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Server Configuration
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8000

# Security Secrets (IMPORTANT: Generate strong random values for production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=your_strong_secret_here_change_in_production
JWT_SECRET=your_jwt_secret_here_change_in_production

# Database (add when implementing persistent storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/ragevfx
