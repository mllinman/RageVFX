# Railway deployment ignore file
# Excludes files from Railway builds to speed up deployment

# Development files
.git/
.github/
.vscode/
.editorconfig
.prettierrc.json
.prettierignore

# Documentation (not needed for runtime)
*.md
!README.md
docs/
examples/

# Build artifacts (will be rebuilt)
dist/
node_modules/

# Test files (no longer in repo)
*.test.ts
*.spec.ts
__tests__/
coverage/

# Desktop app files (not needed for web deployment)
build/
release/
blender-tools/

# Dashboard (separate Next.js app - not part of web deployment)
dashboard/

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE files
.idea/
*.swp
*.swo
*~

# Environment files (use Railway dashboard for env vars)
.env
.env.local
.env.*.local

# Electron-specific
electron-builder.yml

# UI directory (desktop app UI, not web)
ui/
